{
  "name": "create-limitedrun-theme-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Modern toolchain for building Limited Run themes",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "prettier --check \"packages/**/*.{ts,json,md}\" \"*.{md,json}\" \".github/**/*.yml\" && npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\" \"*.{md,json}\" \".github/**/*.yml\"",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
