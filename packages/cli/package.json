  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "ajv": "^8.17.1",
    "chokidar": "^4.0.3",
    "fflate": "^0.8.2",
    "hono": "^4.6.14",
    "liquidjs": "^10.19.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "vitest": "^3.0.5"
  }
}
