{
  "name": "@limitedrun/cli",
  "version": "0.2.0",
  "description": "Local dev server and build tooling for Limited Run themes",
  "license": "MIT",
  "type": "module",
  "bin": {
    "limitedrun": "./dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
