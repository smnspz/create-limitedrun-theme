{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://limitedrun.com/schemas/store.json",
  "title": "Limited Run theme mock data",
  "description": "Shape of the local store.json used to render a theme in the dev server. Mirrors the data Limited Run exposes to Liquid templates in production.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string" },
    "mailbox": {
      "type": "object",
      "properties": { "title": { "type": "string" } },
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "description": "Overrides for configs/default.json setting defaults.",
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "path"],
        "properties": { "title": { "type": "string" }, "path": { "type": "string" } },
        "additionalProperties": true
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": { "name": { "type": "string" }, "url": { "type": "string" } },
        "additionalProperties": true
      }
    },
    "products": { "type": "array", "items": { "$ref": "#/definitions/product" } },
    "events": { "type": "array", "items": { "$ref": "#/definitions/product" } },
    "roster": { "$ref": "#/definitions/collection" },
    "news": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "body"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "published_at": { "type": "string" },
              "body": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "gallery": { "$ref": "#/definitions/collection" },
    "history": { "$ref": "#/definitions/collection" },
    "orders": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "message": { "type": "object", "additionalProperties": true }
  },
  "definitions": {
    "collection": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "v075_url": { "type": "string" },
        "v200_url": { "type": "string" },
        "v300_url": { "type": "string" },
        "v600_url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "product": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": ["integer", "string"] },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "images": { "type": "array", "items": { "$ref": "#/definitions/image" } },
        "variations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": ["integer", "string"] },
              "name": { "type": "string" },
              "price": { "type": ["number", "string"] },
              "available": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "available": { "type": "boolean" },
        "announced": { "type": "boolean" },
        "unavailable": { "type": "boolean" },
        "unlisted": { "type": "boolean" },
        "price_range": {
          "type": "array",
          "items": { "type": ["number", "string"] }
        }
      }
    }
  }
}
